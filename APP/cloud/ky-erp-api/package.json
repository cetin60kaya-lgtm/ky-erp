{
  "name": "ky-erp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/pages-domain-preflight.mjs && wrangler deploy --dry-run",
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "db:migrations:local": "wrangler d1 migrations apply ky-erp-production-local --local --config wrangler.production-local.jsonc",
    "db:migrations:remote": "wrangler d1 migrations apply ky-erp-db --remote --config wrangler.jsonc",
    "db:audit:local": "node scripts/d1-schema-audit.mjs --local --database ky-erp-production-local --config wrangler.production-local.jsonc --require-migrations",
    "db:audit:remote": "node scripts/d1-schema-audit.mjs --remote --database ky-erp-db --config wrangler.jsonc --require-migrations"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
