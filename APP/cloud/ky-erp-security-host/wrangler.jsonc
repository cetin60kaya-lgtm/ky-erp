{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ky-erp-security-host",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "assets": {
    "directory": "../../app/ky-erp-frontend/public/guvenlik",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "security.kyerp.net", "custom_domain": true }
  ]
}
