{
  "name": "hakan-emp",
  "version": "1.3.4",
  "description": "HAKAN EMP - İmalat, Cari ve Çek Takip",
  "main": "main.cjs",
  "author": "HAKAN EMP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "check": "node --check app/server.js && node --check app/public/app.js && node --check main.cjs",
    "test": "node test/smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hakanemp.desktop",
    "productName": "HAKAN EMP",
    "asar": true,
    "files": [
      "main.cjs",
      "app/**/*",
      "seed/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HAKAN-EMP-1.3.4.exe"
    },
    "artifactName": "HAKAN-EMP-1.3.4.exe"
  }
}
