model IsnetInvoiceLineAllocation {
  id                   String                   @id @default(uuid())
  draftRequestId       String                   @map("draft_request_id")
  sourceLineKey        String                   @map("source_line_key")
  sourceIntakeLineId   String?                  @map("source_intake_line_id")
  sourceDocumentLineId String?                  @map("source_document_line_id")
  salesInvoiceLineId   String?                  @map("sales_invoice_line_id")
  modelId              String?                  @map("model_id")
  productName          String?                  @map("product_name")
  dispatchedQuantity   Decimal                  @default(0) @map("dispatched_quantity")
  previouslyBilled     Decimal                  @default(0) @map("previously_billed")
  billedQuantity       Decimal                  @default(0) @map("billed_quantity")
  nonBillableQuantity  Decimal                  @default(0) @map("non_billable_quantity")
  totalBilled          Decimal                  @default(0) @map("total_billed")
  remainingQuantity    Decimal                  @default(0) @map("remaining_quantity")
  status               String                   @default("FATURALANMADI")
  raw                  Json?
  createdAt            DateTime                 @default(now()) @map("created_at")
