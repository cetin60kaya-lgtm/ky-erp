  officialInvoiceNumber String?                      @map("official_invoice_number")
  officialUuid          String?                      @map("official_uuid")
  isnetDocumentId       String?                      @map("isnet_document_id")
  officialStatus        String?                      @map("official_status")
  portalResponseHash    String?                      @map("portal_response_hash")
  pdfPath               String?                      @map("pdf_path")
  xmlPath               String?                      @map("xml_path")
  salesInvoiceId        String?                      @map("sales_invoice_id")
  currentMovementId     String?                      @map("current_movement_id")
  mailPackageId         String?                      @map("mail_package_id")
  error                 String?
  completedAt           DateTime?                    @map("completed_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
