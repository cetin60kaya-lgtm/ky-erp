  @@unique([mainCompanySlug, idempotencyKey])
  @@unique([mainCompanySlug, externalId])
  @@unique([mainCompanySlug, portalDraftId])
  @@unique([mainCompanySlug, officialInvoiceNumber])
  @@unique([mainCompanySlug, officialUuid])
  @@index([mainCompanySlug, sourceId])
  @@index([mainCompanySlug, status])
