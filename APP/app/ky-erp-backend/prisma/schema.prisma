generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Print region definitions for standardization across companies
model PrintRegionDefinition {
  id            String   @id @default(uuid())
  mainCompanyId String?
  regionCode    String
  regionName    String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("print_region_definitions")
}

// Per-model persisted print regions (optional migration)
model ModelPrintRegion {
  id            String   @id @default(uuid())
  modelRecordId String
  mainCompanyId String?
  regionCode    String
  regionName    String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("model_print_regions")
}

model MainCompany {
  id                      String                   @id @default(uuid())
  slug                    String                   @unique
  code                    String?
  name                    String
  legalName               String?                  @map("legal_name")
  taxNumber               String?                  @map("tax_number")
  taxOffice               String?                  @map("tax_office")
  email                   String?
  phone                   String?
  address                 String?
  logo                    String?
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  activityLogs            ActivityLog[]
  companies               Company[]
  companyAliases          CompanyAlias[]
  currentAccountMovements CurrentAccountMovement[]
  documentFiles           DocumentFile[]
  documents               Document[]
  storedFiles             StoredFile[]
  fileStorageRules        FileStorageRule[]
  jobs                    Job[]
  legacyPermissions       LegacyPermission[]
  productAlias            ProductAlias[]
  products                Product[]
  legacyRoles             LegacyRole[]
  legacyUsers             LegacyUser[]
  vatRecords              VatRecord[]
  userMemberships         UserCompanyMembership[]
  authSessions            AuthSession[]
  authActivityLogs        AuthActivityLog[]

  @@map("main_companies")
}

model LegacyUser {
  id              String           @id @default(uuid())
  mainCompanySlug String           @map("main_company_slug")
  email           String
  name            String
  passwordHash    String?          @map("password_hash")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  roles           LegacyUserRole[]
  mainCompany     MainCompany      @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, email])
  @@index([mainCompanySlug])
  @@map("users")
}

model LegacyRole {
  id              String           @id @default(uuid())
  mainCompanySlug String           @map("main_company_slug")
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  mainCompany     MainCompany      @relation(fields: [mainCompanySlug], references: [slug])
  users           LegacyUserRole[]

  @@unique([mainCompanySlug, name])
  @@index([mainCompanySlug])
  @@map("roles")
}

model LegacyUserRole {
  userId String     @map("user_id")
  roleId String     @map("role_id")
  role   LegacyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model LegacyPermission {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  code            String
  description     String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, code])
  @@index([mainCompanySlug])
  @@map("permissions")
}

enum Role {
  ADMIN
  MUHASEBE
  DESEN
  IMALAT
  BOYAHANE
  IK
  VIEWER

  @@map("auth_role")
}

enum ModuleKey {
  DASHBOARD
  MUHASEBE
  FIRMA_CARI
  BELGE_ISLEM
  KDV
  CEK_ODEME
  DESEN
  IMALAT
  BOYAHANE
  IK
  ISNET
  ASISTAN
  ADMIN
  RAPORLAR

  @@map("auth_module_key")
}

model User {
  id                 String                 @id @default(uuid())
  username           String                 @unique
  passwordHash       String                 @map("password_hash")
  fullName           String                 @map("full_name")
  email              String?
  backupEmail        String?                @map("backup_email")
  platformRole       String                 @default("USER") @map("platform_role")
  role               Role
  isActive           Boolean                @default(true) @map("is_active")
  mustChangePassword Boolean                @default(false) @map("must_change_password")
  lastLoginAt        DateTime?              @map("last_login_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  permissions        UserModulePermission[]
  companyMemberships UserCompanyMembership[]
  authSessions       AuthSession[]
  mfaMethods         AuthMfaMethod[]
  authActivityLogs   AuthActivityLog[]

  @@map("auth_users")
}

model UserCompanyMembership {
  id              String                  @id @default(uuid())
  userId          String                  @map("user_id")
  mainCompanyId   String                  @map("main_company_id")
  mainCompanySlug String                  @map("main_company_slug")
  companyRole     String                  @default("VIEWER") @map("company_role")
  isActive        Boolean                 @default(true) @map("is_active")
  isDefault       Boolean                 @default(false) @map("is_default")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainCompany     MainCompany             @relation(fields: [mainCompanyId], references: [id], onDelete: Restrict)
  permissions     UserCompanyPermission[]
  sessions        AuthSession[]

  @@unique([userId, mainCompanyId])
  @@index([mainCompanyId, isActive])
  @@index([userId, isActive])
  @@map("user_company_memberships")
}

model UserCompanyPermission {
  id           String                @id @default(uuid())
  membershipId String                @map("membership_id")
  moduleKey    ModuleKey             @map("module_key")
  canView      Boolean               @default(false) @map("can_view")
  canCreate    Boolean               @default(false) @map("can_create")
  canUpdate    Boolean               @default(false) @map("can_update")
  canDelete    Boolean               @default(false) @map("can_delete")
  canApprove   Boolean               @default(false) @map("can_approve")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  membership   UserCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, moduleKey])
  @@index([membershipId])
  @@map("user_company_permissions")
}

model AuthSession {
  id                  String                 @id @default(uuid())
  userId              String                 @map("user_id")
  membershipId        String?                @map("membership_id")
  activeCompanyId     String?                @map("active_company_id")
  activeCompanySlug   String?                @map("active_company_slug")
  issuedAt            DateTime               @map("issued_at")
  expiresAt           DateTime               @map("expires_at")
  revokedAt           DateTime?              @map("revoked_at")
  replacedBySessionId String?                @map("replaced_by_session_id")
  createdAt           DateTime               @default(now()) @map("created_at")
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          UserCompanyMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  activeCompany       MainCompany?           @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuthMfaMethod {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  methodType        String    @map("method_type")
  label             String?
  secretCiphertext  String?   @map("secret_ciphertext")
  destinationMasked String?   @map("destination_masked")
  isEnabled         Boolean   @default(false) @map("is_enabled")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, methodType, label])
  @@map("auth_mfa_methods")
}

model AuthActivityLog {
  id            String       @id @default(uuid())
  actorUserId   String?      @map("actor_user_id")
  mainCompanyId String?      @map("main_company_id")
  action        String
  targetType    String?      @map("target_type")
  targetId      String?      @map("target_id")
  detailsJson   Json?        @map("details_json")
  createdAt     DateTime     @default(now()) @map("created_at")
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  mainCompany   MainCompany? @relation(fields: [mainCompanyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([mainCompanyId, createdAt])
  @@map("auth_activity_logs")
}

model UserModulePermission {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  moduleKey  ModuleKey @map("module_key")
  canView    Boolean   @default(false) @map("can_view")
  canCreate  Boolean   @default(false) @map("can_create")
  canUpdate  Boolean   @default(false) @map("can_update")
  canDelete  Boolean   @default(false) @map("can_delete")
  canApprove Boolean   @default(false) @map("can_approve")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
  @@map("auth_user_module_permissions")
}

model AiConversation {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  mainCompanySlug String?           @map("main_company_slug")
  title           String
  moduleContext   Json?             @map("module_context")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  messages        AiMessage[]
  pendingActions  AiPendingAction[]

  @@index([userId, updatedAt])
  @@index([mainCompanySlug])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  role           String
  content        String
  toolName       String?        @map("tool_name")
  toolPayload    Json?          @map("tool_payload")
  tokenInput     Int            @default(0) @map("token_input")
  tokenOutput    Int            @default(0) @map("token_output")
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiPendingAction {
  id                    String         @id @default(uuid())
  conversationId        String         @map("conversation_id")
  userId                String         @map("user_id")
  actionType            String         @map("action_type")
  actionPayload         Json           @map("action_payload")
  confirmationTokenHash String         @map("confirmation_token_hash")
  status                String         @default("PENDING")
  expiresAt             DateTime       @map("expires_at")
  approvedAt            DateTime?      @map("approved_at")
  executedAt            DateTime?      @map("executed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  conversation          AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId, status])
  @@map("ai_pending_actions")
}

model AiAuditLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  operation      String
  module         String?
  recordType     String?  @map("record_type")
  recordId       String?  @map("record_id")
  beforeData     Json?    @map("before_data")
  afterData      Json?    @map("after_data")
  success        Boolean  @default(true)
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("ai_audit_logs")
}

model AiUsageDaily {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  usageDate     String   @map("usage_date")
  requestCount  Int      @default(0) @map("request_count")
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  estimatedCost Decimal  @default(0) @map("estimated_cost")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("ai_usage_daily")
}

model Company {
  id                        String                   @id @default(uuid())
  mainCompanySlug           String                   @map("main_company_slug")
  legacyId                  String?                  @map("legacy_id")
  name                      String
  normalizedName            String                   @map("normalized_name")
  type                      String                   @default("SATICI")
  companyType               String                   @default("SUPPLIER") @map("company_type")
  taxNo                     String?                  @map("tax_no")
  taxOffice                 String?                  @map("tax_office")
  phone                     String?
  email                     String?
  address                   String?
  defaultRecordType         String?                  @default("RESMI") @map("default_record_type")
  firmaTuru                 String?                  @map("firma_turu")
  varsayilanRaporKategoriId String?                  @map("varsayilan_rapor_kategori_id")
  defaultVatRate            Decimal                  @default(0) @map("default_vat_rate")
  vatIncludedMode           String?                  @default("HARIC") @map("vat_included_mode")
  currentBalance            Decimal                  @default(0) @map("current_balance")
  openingBalance            Decimal                  @default(0) @map("opening_balance")
  isActive                  Boolean                  @default(true) @map("is_active")
  isFavorite                Boolean                  @default(false) @map("is_favorite")
  note                      String?
  source                    String?                  @default("MANUAL")
  deletedAt                 DateTime?                @map("deleted_at")
  deletedBy                 String?                  @map("deleted_by")
  deleteReason              String?                  @map("delete_reason")
  raw                       Json?
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  mainCompany               MainCompany              @relation(fields: [mainCompanySlug], references: [slug])
  aliases                   CompanyAlias[]
  movements                 CurrentAccountMovement[]
  documents                 Document[]
  vatRecords                VatRecord[]

  @@unique([mainCompanySlug, legacyId])
  @@unique([mainCompanySlug, normalizedName])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, normalizedName])
  @@index([mainCompanySlug, isActive])
  @@index([mainCompanySlug, updatedAt])
  @@index([mainCompanySlug, currentBalance])
  @@index([varsayilanRaporKategoriId])
  @@map("companies")
}

model CompanyAlias {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  companyId       String      @map("company_id")
  rawName         String      @map("raw_name")
  normalizedName  String      @map("normalized_name")
  isActive        Boolean     @default(true) @map("is_active")
  source          String?     @default("MANUAL")
  taxNo           String?     @map("tax_no")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, normalizedName])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, normalizedName])
  @@map("company_aliases")
}

model CurrentAccountMovement {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  companyId       String      @map("company_id")
  movementDate    DateTime    @map("movement_date")
  movementType    String      @map("movement_type")
  sourceType      String      @map("source_type")
  documentNo      String?     @map("document_no")
  documentId      String?     @map("document_id")
  description     String?
  debit           Decimal     @default(0)
  credit          Decimal     @default(0)
  amount          Decimal     @default(0)
  effect          Decimal     @default(0)
  balanceAfter    Decimal     @default(0) @map("balance_after")
  legacyId        String?     @map("legacy_id")
  raw             Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  company         Company     @relation(fields: [companyId], references: [id])
  document        Document?   @relation(fields: [documentId], references: [id])
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@index([mainCompanySlug])
  @@index([mainCompanySlug, movementDate])
  @@index([companyId, movementDate])
  @@index([mainCompanySlug, companyId, movementDate])
  @@index([mainCompanySlug, documentNo])
  @@map("current_account_movements")
}

model Document {
  id              String                   @id @default(uuid())
  mainCompanySlug String                   @map("main_company_slug")
  companyId       String?                  @map("company_id")
  documentNo      String?                  @map("document_no")
  documentType    String?                  @map("document_type")
  sourceType      String?                  @map("source_type")
  date            DateTime?
  subtotal        Decimal                  @default(0)
  vatTotal        Decimal                  @default(0) @map("vat_total")
  grandTotal      Decimal                  @default(0) @map("grand_total")
  status          String                   @default("kontrol_bekliyor")
  processedAt     DateTime?                @map("processed_at")
  rejectReason    String?                  @map("reject_reason")
  fileHash        String?                  @map("file_hash")
  detectedType    String?                  @map("detected_type")
  targetType      String?                  @map("target_type")
  targetModule    String?                  @map("target_module")
  targetRecordId  String?                  @map("target_record_id")
  firmMatchStatus String?                  @map("firm_match_status")
  confidence      Decimal?
  routeStatus     String?                  @map("route_status")
  routeMessage    String?                  @map("route_message")
  raporKategoriId String?                  @map("rapor_kategori_id")
  kategoriKaynagi String?                  @map("kategori_kaynagi")
  deletedAt       DateTime?                @map("deleted_at")
  deletedBy       String?                  @map("deleted_by")
  deleteReason    String?                  @map("delete_reason")
  raw             Json?
  metadata        Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  movements       CurrentAccountMovement[]
  files           DocumentFile[]
  company         Company?                 @relation(fields: [companyId], references: [id])
  mainCompany     MainCompany              @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, targetModule, targetRecordId])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, date])
  @@index([mainCompanySlug, fileHash])
  @@index([mainCompanySlug, documentType])
  @@index([mainCompanySlug, targetType])
  @@index([mainCompanySlug, routeStatus])
  @@index([raporKategoriId])
  @@map("documents")
}

model MuhasebeRaporKategorisi {
  id                 String   @id @default(uuid())
  mainCompanySlug    String   @map("main_company_slug")
  ad                 String
  kod                String?
  kategoriTipi       String   @map("kategori_tipi")
  anaKategoriId      String?  @map("ana_kategori_id")
  sira               Int      @default(0)
  aktifMi            Boolean  @default(true) @map("aktif_mi")
  sistemKategorisiMi Boolean  @default(false) @map("sistem_kategorisi_mi")
  renk               String?
  aciklama           String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([mainCompanySlug, ad])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, kategoriTipi])
  @@index([anaKategoriId])
  @@map("muhasebe_rapor_kategorileri")
}

model MuhasebeRaporManuelKalem {
  id              String    @id @default(uuid())
  mainCompanySlug String    @map("main_company_slug")
  ad              String
  kartTipi        String    @default("KUCUK") @map("kart_tipi")
  kategoriId      String?   @map("kategori_id")
  firmaId         String?   @map("firma_id")
  tarih           DateTime?
  baslangic       DateTime?
  bitis           DateTime?
  tutar           Decimal   @default(0)
  kdv             Decimal   @default(0)
  aciklama        String?
  belgeNo         String?   @map("belge_no")
  resmiTip        String    @default("GAYRI_RESMI") @map("resmi_tip")
  kdvOrani        Decimal   @default(0) @map("kdv_orani")
  raporaDahil     Boolean   @default(true) @map("rapora_dahil")
  odemeSekli      String?   @map("odeme_sekli")
  not             String?
  cariyeEkle      Boolean   @default(false) @map("cariye_ekle")
  cariHareketId   String?   @map("cari_hareket_id")
  sabitSablonId   String?   @map("sabit_sablon_id")
  tahakkukAyi     String?   @map("tahakkuk_ayi")
  islemTuru       String    @default("GIDER") @map("islem_turu")
  aktifMi         Boolean   @default(true) @map("aktif_mi")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([sabitSablonId, tahakkukAyi])
  @@index([mainCompanySlug])
  @@index([kategoriId])
  @@index([firmaId])
  @@map("muhasebe_rapor_manuel_kalemler")
}

model MuhasebeSabitGiderSablonu {
  id              String    @id @default(uuid())
  mainCompanySlug String    @map("main_company_slug")
  ad              String
  kategoriId      String?   @map("kategori_id")
  firmaId         String?   @map("firma_id")
  tutar           Decimal   @default(0)
  resmiTip        String    @default("GAYRI_RESMI") @map("resmi_tip")
  kdvOrani        Decimal   @default(0) @map("kdv_orani")
  baslangicAyi    String    @map("baslangic_ayi")
  bitisAyi        String?   @map("bitis_ayi")
  herAyOtomatik   Boolean   @default(true) @map("her_ay_otomatik")
  cariyeEkle      Boolean   @default(false) @map("cariye_ekle")
  aktifMi         Boolean   @default(true) @map("aktif_mi")
  aciklama        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([mainCompanySlug, aktifMi])
  @@index([kategoriId])
  @@map("muhasebe_sabit_gider_sablonlari")
}

model MuhasebeRaporKayitAyari {
  id                  String   @id @default(uuid())
  mainCompanySlug     String   @map("main_company_slug")
  sourceType          String   @map("source_type")
  sourceId            String   @map("source_id")
  reportIncluded      Boolean? @map("report_included")
  reportCategoryId    String?  @map("report_category_id")
  reportAmount        Decimal? @map("report_amount")
  reportDescription   String?  @map("report_description")
  reportOfficialType  String?  @map("report_official_type")
  reportVatAmount     Decimal? @map("report_vat_amount")
  reportVatIncluded   Boolean? @map("report_vat_included")
  reportExpenseStatus String?  @map("report_expense_status")
  reportNote          String?  @map("report_note")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([mainCompanySlug, sourceType, sourceId])
  @@index([mainCompanySlug, reportIncluded])
  @@index([reportCategoryId])
  @@map("muhasebe_rapor_kayit_ayarlari")
}

model DocumentFile {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  documentId      String      @map("document_id")
  filePath        String      @map("file_path")
