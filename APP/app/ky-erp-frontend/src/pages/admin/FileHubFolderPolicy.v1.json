  "rootSelection": "firmaya ait mevcut gerçek kök klasör yönetim ekranından seçilir; sabit Hakan Emp kökü yok",
  "storageIdentity": "file_hub_assets.id; provider locations in file_hub_locations; entity relations in file_hub_relations; no extra physical copies",
  "linkingRules": {
    "modelCreate": "Only MODEL_IMAGE image file filename without extension creates canonical model card; idempotent",
    "sharedModelViews": [
      "MODEL_IMAGE",
      "PLACEMENT",
      "MODEL_PSD_PREVIEW"
    ],
    "psd": "Orijinal MODEL_SOURCE yetkili DESEN'de; genel görünüm önizleme",
    "accountingVisibility": "No blanket accounting access; only model-associated customer dispatch to manufacturing",
    "invoiceFilename": "<BelgeNo> <ModelAdi>.[xml|pdf] when model exists; XML ETTN is canonical source",
    "synchronization": "Direct provider cloud API + D1 incremental indexing; local Windows optional for İşNet/Photoshop/RIP; no per-user repeated scan",
    "folderOperations": "Add, attach, rename label, reassign, disable mapping, scan, preview move; physical move/rename separate approval; never delete originals on unbind",
    "release": "Signed/verified setup artifact via admin page + SHA256; no binary embedded in public GitHub source; no install without approval"
  },
