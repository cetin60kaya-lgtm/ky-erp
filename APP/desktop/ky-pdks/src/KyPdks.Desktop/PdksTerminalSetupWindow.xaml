<Window x:Class="KyPdks.Desktop.PdksTerminalSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KY PDKS Pro · Terminal Kurulum Sihirbazı"
        Width="1120" Height="800" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="#F4F7FA"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#CBD8E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD8E4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderBrush" Value="#C9D7E3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9E4ED" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Terminal Kurulum Sihirbazı" FontSize="24" FontWeight="Bold" Foreground="#173B5B"/>
                    <TextBlock Text="Cihazı bir kez tanımla; KYERP.PDKS.Agent arka planda kartları toplamaya devam etsin." Foreground="#6C8194" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,6" CornerRadius="14" Background="#E9F7EF" BorderBrush="#C8E8D5" BorderThickness="1">
                    <TextBlock x:Name="WriteStateText" Text="Yerel ayar yazılabilir" Foreground="#2B724C" FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#173B5B" CornerRadius="14" Padding="18">
                <StackPanel>
                    <TextBlock Text="KY PDKS PRO" Foreground="#8FC7EE" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Text="Hızlı Profiller" Foreground="White" FontWeight="Bold" FontSize="19" Margin="0,4,0,14"/>
                    <Button Content="İşyeri Hedef500" Click="HedefProfile_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Dosya / TXT-DAT" Click="FileProfile_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="TCP Client" Click="TcpProfile_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Serial / COM" Click="SerialProfile_Click" HorizontalContentAlignment="Left"/>
                    <Separator Margin="0,14,0,14" Background="#3D5F7B"/>
                    <TextBlock Text="Güvenli davranış" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#B9CBD9" FontSize="10" Margin="0,6,0,0"
                               Text="Test işlemi TCP port erişimini ve veri dosyasını okur. Cihaz saati, kapı rölesi, yönetici silme veya yeniden başlatma komutu doğrulanmış üretici protokolü olmadan gönderilmez."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#B9CBD9" FontSize="10" Margin="0,12,0,0"
                               Text="Terminal doğrudan internete açılmaz. Agent işyeri LAN'ından HTTPS ile KY ERP'ye senkron olur."/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="#DBE5EE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1 · CİHAZ KİMLİĞİ" Foreground="#2A719F" FontWeight="Bold" FontSize="10"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Cihaz adı"/><TextBox x:Name="DeviceNameBox"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Cihaz No"/><TextBox x:Name="DeviceNoBox"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Makine No"/><TextBox x:Name="MachineNoBox"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Terminal yönü"/><ComboBox x:Name="DirectionCombo"><ComboBoxItem Content="GİRİŞ" Tag="GIRIS"/><ComboBoxItem Content="ÇIKIŞ" Tag="CIKIS"/><ComboBoxItem Content="OTOMATİK" Tag="AUTO"/></ComboBox></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#DBE5EE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2 · KART KAYNAĞI &amp; BAĞLANTI" Foreground="#2A719F" FontWeight="Bold" FontSize="10"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Kaynak modu"/><ComboBox x:Name="SourceModeCombo"><ComboBoxItem Content="Hedef / TR500" Tag="HEDEF_TR500"/><ComboBoxItem Content="Dosya" Tag="FILE"/><ComboBoxItem Content="TCP Server" Tag="TCP_SERVER"/><ComboBoxItem Content="TCP Client" Tag="TCP_CLIENT"/><ComboBoxItem Content="Serial / COM" Tag="SERIAL"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="TCP Host / IP"/><TextBox x:Name="TcpHostBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="TCP Port"/><TextBox x:Name="TcpPortBox"/></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Hedef / veri dosyası"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="HedefReadBox"/><Button Grid.Column="1" Content="Gözat" Click="BrowseReadFile_Click" Margin="6,4,0,10"/></Grid></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="COM Port"/><TextBox x:Name="SerialPortBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Baud"/><TextBox x:Name="SerialBaudBox"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Cihaz yazma dosyası / üretici köprüsü (opsiyonel)"/>
                            <TextBox x:Name="HedefWriteBox"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#DBE5EE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3 · OTOMASYON" Foreground="#2A719F" FontWeight="Bold" FontSize="10"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Tarama aralığı (ms)"/><TextBox x:Name="ScanIntervalBox"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="D1 senkron aralığı (sn)"/><TextBox x:Name="SyncIntervalBox"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,22,0,0" Orientation="Horizontal">
                                    <CheckBox x:Name="AutoSyncCheck" Content="Otomatik D1 senkron" Margin="0,0,18,0"/>
                                    <CheckBox x:Name="FileImportCheck" Content="Import klasörünü izle"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#DBE5EE" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="4 · DOĞRULAMA" Foreground="#2A719F" FontWeight="Bold" FontSize="10"/><TextBlock Text="Kaydetmeden önce bağlantıyı güvenli şekilde kontrol et." Foreground="#75889A" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="Bağlantıyı Test Et" Click="TestButton_Click" Background="#EEF6FC" BorderBrush="#A9C7DE"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Margin="0,0,8,0" Padding="10" CornerRadius="9" Background="#F7FAFC"><StackPanel><TextBlock Text="PC Saati" Foreground="#718396" FontSize="9"/><TextBlock x:Name="PcClockText" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Margin="0,0,8,0" Padding="10" CornerRadius="9" Background="#F7FAFC"><StackPanel><TextBlock Text="TCP" Foreground="#718396" FontSize="9"/><TextBlock x:Name="TcpProbeText" Text="Kontrol edilmedi" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Padding="10" CornerRadius="9" Background="#F7FAFC"><StackPanel><TextBlock Text="Veri Dosyası / Son Kart" Foreground="#718396" FontSize="9"/><TextBlock x:Name="FileProbeText" Text="Kontrol edilmedi" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9E4ED" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ayarlar yükleniyor..." VerticalAlignment="Center" Foreground="#657A8D"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Kapat" Click="CloseButton_Click"/>
                    <Button x:Name="SaveButton" Content="Kaydet ve Tamamla" Click="SaveButton_Click" Background="#1F6FA5" BorderBrush="#1F6FA5" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>