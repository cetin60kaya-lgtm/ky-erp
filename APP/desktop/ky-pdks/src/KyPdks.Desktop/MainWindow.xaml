<Window x:Class="KyPdks.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KY PDKS" Height="820" Width="1280" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource KyDark}" Margin="0,0,12,0">
            <TextBlock Text="KY" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="KY PDKS" FontWeight="Bold" FontSize="23" Foreground="{StaticResource KyDark}"/>
            <TextBlock Text="Yerel kart toplama · KY ERP bağlantısı · Windows PDKS" Foreground="#718197" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Padding="10,6" CornerRadius="12" BorderBrush="#BFE2CD" BorderThickness="1" Background="#EEFAF3" Margin="0,0,8,0">
            <TextBlock x:Name="AgentStateText" Text="Agent kontrol ediliyor" Foreground="#277246" FontWeight="SemiBold"/>
          </Border>
          <Border Padding="10,6" CornerRadius="12" BorderBrush="#C7D7EA" BorderThickness="1" Background="#F2F7FC" Margin="0,0,8,0">
            <TextBlock x:Name="ErpStateText" Text="ERP: Oturum yok" Foreground="#31587E" FontWeight="SemiBold"/>
          </Border>
          <Button Content="KY ERP Web" Click="OpenWebButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
        <TabItem Header="Genel Bakış">
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="4">
              <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="Bugün Kart" Foreground="#718197"/><TextBlock x:Name="TodayCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource KyDark}"/><TextBlock Text="Yerel ham kayıt" Foreground="#94A1B2" FontSize="11"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="Bekleyen" Foreground="#718197"/><TextBlock x:Name="PendingBigText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#B06A16"/><TextBlock Text="ERP senkron bekliyor" Foreground="#94A1B2" FontSize="11"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="Senkronlanan" Foreground="#718197"/><TextBlock x:Name="SyncedCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#277246"/><TextBlock Text="KY ERP'ye işlendi" Foreground="#94A1B2" FontSize="11"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="15">
                <StackPanel><TextBlock Text="Kontrol Gereken" Foreground="#718197"/><TextBlock x:Name="ErrorCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#A53232"/><TextBlock Text="Eşleşmeyen / reddedilen" Foreground="#94A1B2" FontSize="11"/></StackPanel>
              </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="17">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="ERP BAĞLANTISI" FontSize="11" FontWeight="Bold" Foreground="#718197"/>
                    <TextBlock Text="Bu bilgisayarı KY ERP hesabıyla doğrula" FontSize="18" FontWeight="Bold" Foreground="{StaticResource KyDark}" Margin="0,5,0,2"/>
                    <TextBlock x:Name="ActivationStateText" Text="Cihaz henüz doğrulanmadı" Foreground="#718197"/>
                  </StackPanel>

                  <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <StackPanel x:Name="LoginPanel">
                      <TextBlock Text="Kullanıcı adı / e-posta" FontWeight="SemiBold" Foreground="#42566F"/>
                      <TextBox x:Name="UsernameBox"/>
                      <TextBlock Text="Parola" FontWeight="SemiBold" Foreground="#42566F"/>
                      <PasswordBox x:Name="PasswordBox"/>
                      <Button x:Name="LoginButton" Content="KY ERP ile Giriş" Click="LoginButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/>
                      <TextBlock Text="Parola bu bilgisayarda saklanmaz." Foreground="#8997A8" FontSize="11" Margin="4,3"/>
                    </StackPanel>

                    <Border x:Name="MfaPanel" Visibility="Collapsed" Background="#FFF8E7" BorderBrush="#F0D69A" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="Authenticator doğrulaması" FontWeight="Bold" Foreground="#795B17"/>
                        <TextBlock x:Name="MfaProviderText" Text="6 haneli kod" Foreground="#866B2B" Margin="0,3,0,4"/>
                        <ComboBox x:Name="MfaProviderCombo" Margin="0,3,0,5">
                          <ComboBoxItem Content="Google Authenticator" Tag="GOOGLE"/>
                          <ComboBoxItem Content="Microsoft Authenticator" Tag="MICROSOFT"/>
                        </ComboBox>
                        <TextBox x:Name="MfaCodeBox" MaxLength="6"/>
                        <Button Content="Doğrula" Click="MfaButton_Click"/>
                      </StackPanel>
                    </Border>

                    <Border x:Name="ApprovalPanel" Visibility="Collapsed" Background="#EEF5FF" BorderBrush="#BED2EE" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="Giriş onayı bekleniyor" FontWeight="Bold" Foreground="#31587E"/>
                        <TextBlock x:Name="ApprovalText" Text="KY ERP onayı kontrol ediliyor..." TextWrapping="Wrap" Foreground="#546E89" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>

                    <StackPanel x:Name="AuthenticatedPanel" Visibility="Collapsed">
                      <Border Background="#EEFAF3" BorderBrush="#BFE2CD" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                          <TextBlock Text="Bağlı kullanıcı" Foreground="#5D7A69" FontSize="11"/>
                          <TextBlock x:Name="AccountNameText" Text="-" FontSize="18" FontWeight="Bold" Foreground="#214F37"/>
                          <TextBlock x:Name="AccountRoleText" Text="-" Foreground="#4D725C"/>
                        </StackPanel>
                      </Border>
                      <Button x:Name="SyncButton" Content="Şimdi ERP'ye Senkronize Et" Click="SyncButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0" Margin="4,12,4,4"/>
                      <Button Content="Oturumu Kapat" Click="LogoutButton_Click"/>
                    </StackPanel>

                    <Separator Margin="0,13"/>
                    <TextBlock Text="YEREL DURUM" FontSize="11" FontWeight="Bold" Foreground="#718197"/>
                    <TextBlock x:Name="LocalStatusText" Text="Yerel veritabanı hazırlanıyor..." Foreground="#42566F" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <TextBlock x:Name="NoticeText" Foreground="#31587E" TextWrapping="Wrap" Margin="0,7,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <StackPanel Margin="2,0,0,10">
                    <TextBlock Text="Son Kart Hareketleri" FontSize="18" FontWeight="Bold" Foreground="{StaticResource KyDark}"/>
                    <TextBlock Text="Ham kart kayıtları önce yerel veritabanına yazılır; internet kesilse de kayıt durmaz." Foreground="#718197" FontSize="12"/>
                  </StackPanel>
                  <DataGrid Grid.Row="1" x:Name="OverviewPunchGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/>
                      <DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="85"/>
                      <DataGridTextColumn Header="Tarih" Binding="{Binding WorkDate}" Width="105"/>
                      <DataGridTextColumn Header="Saat" Binding="{Binding EventTime}" Width="85"/>
                      <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="105"/>
                      <DataGridTextColumn Header="Durum" Binding="{Binding SyncState}" Width="100"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Canlı Kart">
          <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="2,0,2,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Canlı Kart Akışı" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KyDark}"/><TextBlock Text="Dosya, TCP veya seri porttan alınan son 500 ham hareket." Foreground="#718197"/></StackPanel>
                <Button Grid.Column="1" Content="Yenile" Click="RefreshLocalButton_Click"/>
              </Grid>
              <DataGrid Grid.Row="1" x:Name="LivePunchGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/>
                  <DataGridTextColumn Header="Kart No" Binding="{Binding CardNo}" Width="95"/>
                  <DataGridTextColumn Header="Tarih" Binding="{Binding WorkDate}" Width="110"/>
                  <DataGridTextColumn Header="Saat" Binding="{Binding EventTime}" Width="90"/>
                  <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="110"/>
                  <DataGridTextColumn Header="Referans" Binding="{Binding SourceRef}" Width="170"/>
                  <DataGridTextColumn Header="ERP" Binding="{Binding SyncState}" Width="100"/>
                  <DataGridTextColumn Header="Açıklama" Binding="{Binding SyncError}" Width="220"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </TabItem>

        <TabItem Header="Personel">
          <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Margin="2,0,0,10"><TextBlock Text="PDKS Personeli" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KyDark}"/><TextBlock x:Name="PeopleInfoText" Text="KY ERP'den alınan yalnız SGK=VAR ve kart numarası bulunan personel." Foreground="#718197"/></StackPanel>
              <DataGrid Grid.Row="1" x:Name="PeopleGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kart No" Binding="{Binding CardNo}" Width="100"/>
                  <DataGridTextColumn Header="Kod" Binding="{Binding PersonnelCode}" Width="100"/>
                  <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                  <DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="180"/>
                  <DataGridTextColumn Header="Görev" Binding="{Binding Title}" Width="180"/>
                  <DataGridTextColumn Header="SGK" Binding="{Binding SgkStatus}" Width="75"/>
                  <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100"/>
                  <DataGridTextColumn Header="İşten Çıkış" Binding="{Binding ExitDate}" Width="105"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </TabItem>

        <TabItem Header="Terminal ve Ayarlar">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                  <TextBlock Text="Kart Terminali" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KyDark}"/>
                  <TextBlock Text="Dosya, TCP sunucu, TCP istemci ve seri port kaynağı desteklenir." Foreground="#718197" Margin="0,2,0,12"/>
                  <TextBlock Text="Kaynak modu" FontWeight="SemiBold"/><ComboBox x:Name="SourceModeCombo" Margin="0,4,0,8"><ComboBoxItem Content="Dosya / klasör" Tag="FILE"/><ComboBoxItem Content="TCP Sunucu (cihaz bağlanır)" Tag="TCP_SERVER"/><ComboBoxItem Content="TCP İstemci (cihaza bağlan)" Tag="TCP_CLIENT"/><ComboBoxItem Content="Seri Port / COM" Tag="SERIAL"/></ComboBox>
                  <TextBlock Text="TCP cihaz adresi" FontWeight="SemiBold"/><TextBox x:Name="TcpHostBox"/>
                  <TextBlock Text="TCP port" FontWeight="SemiBold"/><TextBox x:Name="TcpPortBox"/>
                  <TextBlock Text="Seri port" FontWeight="SemiBold"/><TextBox x:Name="SerialPortBox"/>
                  <TextBlock Text="Baud" FontWeight="SemiBold"/><ComboBox x:Name="SerialBaudCombo" Margin="0,4,0,8"><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/></ComboBox>
                  <TextBlock Text="Satır kodlaması" FontWeight="SemiBold"/><TextBox x:Name="EncodingBox"/>
                  <CheckBox x:Name="FileImportCheck" Content="Import klasöründen dosya okumayı açık tut" Margin="0,5"/>
                  <CheckBox x:Name="AutoSyncCheck" Content="Uygulama açık ve ERP oturumu geçerliyken otomatik senkronize et" Margin="0,5"/>
                  <TextBlock Text="Senkron aralığı (sn)" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBox x:Name="SyncIntervalBox"/>
                  <Button Content="Ayarları Kaydet" Click="SaveSettingsButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/>
                  <Button Content="Kart Agent Servisini Yeniden Başlat" Click="RestartAgentButton_Click"/>
                  <TextBlock x:Name="TerminalStateText" Text="Terminal durumu: -" Foreground="#546E89" TextWrapping="Wrap" Margin="4,8"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                  <TextBlock Text="Yerel Veri ve Bakım" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KyDark}"/>
                  <TextBlock Text="Çalışma veritabanı ProgramData altında yereldir. Bulut klasörü içinde açık DB tutulmaz." Foreground="#718197" TextWrapping="Wrap" Margin="0,2,0,12"/>
                  <TextBlock Text="Veritabanı" FontWeight="SemiBold"/><TextBlock x:Name="DatabasePathText" Foreground="#546E89" TextWrapping="Wrap" Margin="0,3,0,10"/>
                  <TextBlock Text="Cihaz kimliği" FontWeight="SemiBold"/><TextBlock x:Name="DeviceIdText" Foreground="#546E89" TextWrapping="Wrap" Margin="0,3,0,10"/>
                  <Button Content="Import Klasörünü Aç" Click="OpenImportButton_Click"/>
                  <Button Content="Arşiv Klasörünü Aç" Click="OpenArchiveButton_Click"/>
                  <Button Content="Yerel Veri Klasörünü Aç" Click="OpenDataButton_Click"/>
                  <Button Content="Şimdi Yedek Al" Click="BackupButton_Click"/>
                  <Separator Margin="0,14"/>
                  <TextBlock Text="Çalışma ilkesi" FontWeight="Bold" Foreground="#294968"/>
                  <TextBlock Text="• Kart basımı interneti beklemez.&#10;• Ham kayıt silinmez ve fingerprint ile mükerrer alınmaz.&#10;• ERP'ye yalnız SGK=VAR + kartlı personel eşleşmesi gönderilir.&#10;• Program kapanınca Agent kart toplamaya devam eder.&#10;• ERP oturum/parolası Agent'a verilmez; parola diske yazılmaz." Foreground="#5F7186" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="2" Background="#172D49">
      <Grid Margin="16,0"><TextBlock Text="KY ERP · KY PDKS Windows 1.0" Foreground="#DDE8F5" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="DeviceText" HorizontalAlignment="Right" Foreground="#AFC2D8" VerticalAlignment="Center" FontSize="11"/></Grid>
    </Border>
  </Grid>
</Window>
