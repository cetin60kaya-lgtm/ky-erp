<Window x:Class="KyPdks.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="KY PDKS" Height="900" Width="1440" MinHeight="760" MinWidth="1200"
 WindowStartupLocation="CenterScreen" Background="#F3F6FA" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="0,0,0,1">
   <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource KyDark}" Margin="0,0,12,0"><TextBlock Text="KY" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel><TextBlock Text="KY PDKS" FontSize="23" FontWeight="Bold" Foreground="{StaticResource KyDark}"/><TextBlock Text="Personel devam kontrol · kart terminali · puantaj · KY ERP" Foreground="#708196" FontSize="12"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Dönem" VerticalAlignment="Center" Foreground="#708196" Margin="0,0,5,0"/>
     <ComboBox x:Name="MonthCombo" Width="125" Margin="0,0,5,0" DisplayMemberPath="Name" SelectedValuePath="Value"/>
     <ComboBox x:Name="YearCombo" Width="82" Margin="0,0,6,0"/>
     <Button Content="Dönemi Yükle" Click="ReloadPeriodButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/>
     <Border Padding="9,6" CornerRadius="11" Background="#EEFAF3" BorderBrush="#BFE2CD" BorderThickness="1" Margin="8,0,5,0"><TextBlock x:Name="AgentStateText" Text="Agent kontrol ediliyor" Foreground="#267048" FontWeight="SemiBold"/></Border>
     <Border Padding="9,6" CornerRadius="11" Background="#F1F6FC" BorderBrush="#CAD8E7" BorderThickness="1" Margin="0,0,5,0"><TextBlock x:Name="ErpStateText" Text="ERP: Oturum yok" Foreground="#31587E" FontWeight="SemiBold"/></Border>
     <Button Content="KY ERP Web" Click="OpenWebButton_Click"/>
    </StackPanel>
   </Grid>
  </Border>

  <TabControl Grid.Row="1" x:Name="MainTabs" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="10">
   <TabControl.Resources>
    <Style TargetType="TabItem"><Setter Property="Width" Value="205"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#334B65"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeaderWidth" Value="0"/></Style>
   </TabControl.Resources>

   <TabItem Header="Genel Bakış"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <UniformGrid Columns="6">
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="Bugün Kart" Foreground="#708196"/><TextBlock x:Name="TodayCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Ham hareket" Foreground="#94A1B2" FontSize="11"/></StackPanel></Border>
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="Çalışan" Foreground="#708196"/><TextBlock x:Name="WorkedTodayText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#277246"/><TextBlock Text="Bugün çalıştı" Foreground="#94A1B2" FontSize="11"/></StackPanel></Border>
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="Eksik / Kart Yok" Foreground="#708196"/><TextBlock x:Name="MissingTodayText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#A53232"/><TextBlock Text="Kontrol gereken" Foreground="#94A1B2" FontSize="11"/></StackPanel></Border>
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="Bekleyen" Foreground="#708196"/><TextBlock x:Name="PendingBigText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#B06A16"/><TextBlock Text="ERP senkron" Foreground="#94A1B2" FontSize="11"/></StackPanel></Border>
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="Senkronlanan" Foreground="#708196"/><TextBlock x:Name="SyncedCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#277246"/><TextBlock Text="ERP'ye işlendi" Foreground="#94A1B2" FontSize="11"/></StackPanel></Border>
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="Hatalı" Foreground="#708196"/><TextBlock x:Name="ErrorCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#A53232"/><TextBlock Text="Eşleşmeyen" Foreground="#94A1B2" FontSize="11"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="ERP BAĞLANTISI" FontWeight="Bold" FontSize="11" Foreground="#708196"/><TextBlock Text="KY ERP hesabıyla bağlan" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/><TextBlock x:Name="ActivationStateText" Text="ERP hesabıyla giriş bekleniyor" Foreground="#708196"/>
      <StackPanel x:Name="LoginPanel" Margin="0,12,0,0"><TextBlock Text="Kullanıcı adı / e-posta" FontWeight="SemiBold"/><TextBox x:Name="UsernameBox"/><TextBlock Text="Parola" FontWeight="SemiBold"/><PasswordBox x:Name="PasswordBox"/><Button x:Name="LoginButton" Content="KY ERP ile Giriş" Click="LoginButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/><TextBlock Text="Parola bilgisayarda saklanmaz." Foreground="#8997A8" FontSize="11"/></StackPanel>
      <Border x:Name="MfaPanel" Visibility="Collapsed" Background="#FFF8E7" BorderBrush="#F0D69A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="Authenticator doğrulaması" FontWeight="Bold"/><TextBlock x:Name="MfaProviderText" Text="6 haneli kod" Margin="0,3"/><ComboBox x:Name="MfaProviderCombo"><ComboBoxItem Content="Google Authenticator" Tag="GOOGLE"/><ComboBoxItem Content="Microsoft Authenticator" Tag="MICROSOFT"/></ComboBox><TextBox x:Name="MfaCodeBox" MaxLength="6"/><Button Content="Doğrula" Click="MfaButton_Click"/></StackPanel></Border>
      <Border x:Name="ApprovalPanel" Visibility="Collapsed" Background="#EEF5FF" BorderBrush="#BED2EE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="Giriş onayı bekleniyor" FontWeight="Bold"/><TextBlock x:Name="ApprovalText" TextWrapping="Wrap"/></StackPanel></Border>
      <StackPanel x:Name="AuthenticatedPanel" Visibility="Collapsed" Margin="0,10,0,0"><Border Background="#EEFAF3" BorderBrush="#BFE2CD" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="Bağlı kullanıcı" FontSize="11"/><TextBlock x:Name="AccountNameText" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="AccountRoleText"/></StackPanel></Border><Button x:Name="SyncButton" Content="ERP ile Senkronize Et" Click="SyncButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/><Button Content="Oturumu Kapat" Click="LogoutButton_Click"/></StackPanel>
      <Separator Margin="0,12"/><TextBlock Text="YEREL DURUM" FontWeight="Bold" FontSize="11" Foreground="#708196"/><TextBlock x:Name="LocalStatusText" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#31587E" Margin="0,6,0,0"/>
     </StackPanel></ScrollViewer></Border>
     <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,0,8"><TextBlock Text="Son Kart Hareketleri" FontSize="18" FontWeight="Bold"/><TextBlock Text="Kart basımları önce yerel veritabanına yazılır; internet kesilse de kayıt durmaz." Foreground="#708196"/></StackPanel><DataGrid Grid.Row="1" x:Name="OverviewPunchGrid"><DataGrid.Columns><DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="80"/><DataGridTextColumn Header="Tarih" Binding="{Binding WorkDate}" Width="100"/><DataGridTextColumn Header="Saat" Binding="{Binding EventTime}" Width="80"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="110"/><DataGridTextColumn Header="ERP" Binding="{Binding SyncState}" Width="95"/></DataGrid.Columns></DataGrid></Grid></Border>
    </Grid>
   </Grid></TabItem>

   <TabItem Header="Canlı Kart"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Canlı Kart Akışı" FontSize="20" FontWeight="Bold"/><TextBlock Text="Dosya, TCP veya COM üzerinden gelen son 500 ham kart hareketi." Foreground="#708196"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="RefreshLocalButton_Click"/></Grid><DataGrid Grid.Row="1" x:Name="LivePunchGrid"><DataGrid.Columns><DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="90"/><DataGridTextColumn Header="Tarih" Binding="{Binding WorkDate}" Width="105"/><DataGridTextColumn Header="Saat" Binding="{Binding EventTime}" Width="85"/><DataGridTextColumn Header="Yön" Binding="{Binding Direction}" Width="80"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="115"/><DataGridTextColumn Header="Referans" Binding="{Binding SourceRef}" Width="170"/><DataGridTextColumn Header="ERP" Binding="{Binding SyncState}" Width="90"/><DataGridTextColumn Header="Açıklama" Binding="{Binding SyncError}" Width="220"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>

   <TabItem Header="Giriş / Çıkışlar"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Gün Gün Giriş / Çıkış" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid Grid.Row="1" x:Name="DailyGrid"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="100"/><DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="80"/><DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="140"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Giriş" Binding="{Binding Entry}" Width="75"/><DataGridTextColumn Header="Çıkış" Binding="{Binding Exit}" Width="75"/><DataGridTextColumn Header="Geç" Binding="{Binding LateMinutes}" Width="65"/><DataGridTextColumn Header="Erken" Binding="{Binding EarlyMinutes}" Width="65"/><DataGridTextColumn Header="Fazla" Binding="{Binding OvertimeMinutes}" Width="65"/><DataGridTextColumn Header="Kaynak" Binding="{Binding DataSource}" Width="95"/><DataGridTextColumn Header="Not" Binding="{Binding Note}" Width="180"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>

   <TabItem Header="Eksik / Düzeltme"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="ManualEventPanel" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="Manuel Kart Hareketi" FontSize="18" FontWeight="Bold"/><TextBlock Text="Yetkili kullanıcı için ERP'ye gerçek kart hareketi ekler. Denetim hesabında kapalıdır." Foreground="#708196" TextWrapping="Wrap" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="ManualPersonCombo" DisplayMemberPath="FullName" Margin="0,4,6,4"/><DatePicker Grid.Column="1" x:Name="ManualDatePicker" Margin="0,4,6,4"/><TextBox Grid.Column="2" x:Name="ManualTimeBox" Text="08:30" Margin="0,4,6,4"/><ComboBox Grid.Column="3" x:Name="ManualDirectionCombo" Margin="0,4,0,4"><ComboBoxItem Content="Otomatik" Tag="AUTO"/><ComboBoxItem Content="Giriş" Tag="IN"/><ComboBoxItem Content="Çıkış" Tag="OUT"/></ComboBox></Grid><TextBox x:Name="ManualNoteBox" Text="Kart okutmadı / manuel kayıt"/><Button Content="Kart Hareketini ERP'ye Kaydet" Click="AddManualEventButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Grid.Column="2" x:Name="OverridePanel" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="Gün Düzeltmesi / Override" FontSize="18" FontWeight="Bold"/><TextBlock Text="Giriş-çıkış ve günlük durumu ERP puantajına yazar." Foreground="#708196" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="OverridePersonCombo" DisplayMemberPath="FullName" Margin="0,4,6,4"/><DatePicker Grid.Column="1" x:Name="OverrideDatePicker" Margin="0,4,6,4"/><ComboBox Grid.Column="2" x:Name="OverrideStatusCombo" Margin="0,4,0,4"><ComboBoxItem Content="Otomatik" Tag="AUTO"/><ComboBoxItem Content="Çalıştı" Tag="CALISTI"/><ComboBoxItem Content="Eksik Basım" Tag="EKSIK_BASIM"/><ComboBoxItem Content="Kart Yok" Tag="KART_YOK"/><ComboBoxItem Content="İzin" Tag="IZIN"/><ComboBoxItem Content="Yıllık İzin" Tag="YILLIK_IZIN"/></ComboBox></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="OverrideInBox" Text="08:30" Margin="0,4,6,4"/><TextBox Grid.Column="1" x:Name="OverrideOutBox" Text="19:00" Margin="0,4,6,4"/><TextBox Grid.Column="2" x:Name="OverrideNoteBox" Text="PDKS manuel düzeltme" Margin="0,4,0,4"/></Grid><Button Content="Gün Düzeltmesini ERP'ye Kaydet" Click="SaveOverrideButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0" HorizontalAlignment="Left"/></StackPanel></Border>
   </Grid><Border Grid.Row="2" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Kontrol Gereken Günler" FontSize="18" FontWeight="Bold"/><DataGrid Grid.Row="1" x:Name="MissingGrid" SelectionChanged="MissingGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="100"/><DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="80"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Giriş" Binding="{Binding Entry}" Width="75"/><DataGridTextColumn Header="Çıkış" Binding="{Binding Exit}" Width="75"/><DataGridTextColumn Header="Not" Binding="{Binding Note}" Width="220"/></DataGrid.Columns></DataGrid></Grid></Border></Grid></TabItem>

   <TabItem Header="Personel Bilgileri"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,8"><TextBlock Text="PDKS Personeli" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="PeopleInfoText" Text="Yalnız SGK=VAR ve kart numarası bulunan personel." Foreground="#708196"/></StackPanel><DataGrid Grid.Row="1" x:Name="PeopleGrid"><DataGrid.Columns><DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="85"/><DataGridTextColumn Header="Kod" Binding="{Binding PersonnelCode}" Width="90"/><DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="150"/><DataGridTextColumn Header="Görev" Binding="{Binding Title}" Width="150"/><DataGridTextColumn Header="SGK" Binding="{Binding SgkStatus}" Width="70"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="İşe Giriş" Binding="{Binding StartDate}" Width="100"/><DataGridTextColumn Header="İşten Çıkış" Binding="{Binding ExitDate}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>

   <TabItem Header="Puantaj"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Aylık Puantaj" FontSize="20" FontWeight="Bold"/><DataGrid Grid.Row="1" x:Name="PuantajGrid"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="100"/><DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="130"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Giriş" Binding="{Binding Entry}" Width="70"/><DataGridTextColumn Header="Çıkış" Binding="{Binding Exit}" Width="70"/><DataGridTextColumn Header="Geç dk" Binding="{Binding LateMinutes}" Width="70"/><DataGridTextColumn Header="Erken dk" Binding="{Binding EarlyMinutes}" Width="75"/><DataGridTextColumn Header="Fazla dk" Binding="{Binding OvertimeMinutes}" Width="75"/><DataGridCheckBoxColumn Header="Eksik" Binding="{Binding MissingPunch}" Width="65"/><DataGridTextColumn Header="Not" Binding="{Binding Note}" Width="180"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>

   <TabItem Header="Puantaj Sonuçları"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Aylık Personel Sonuçları" FontSize="20" FontWeight="Bold"/><DataGrid Grid.Row="1" x:Name="TimesheetGrid"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding PersonnelCode}" Width="85"/><DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="125"/><DataGridTextColumn Header="Çalışılan" Binding="{Binding WorkedDays}" Width="75"/><DataGridTextColumn Header="Yıllık İzin" Binding="{Binding AnnualLeaveDays}" Width="80"/><DataGridTextColumn Header="İzin" Binding="{Binding LeaveDays}" Width="65"/><DataGridTextColumn Header="Eksik Basım" Binding="{Binding MissingPunchDays}" Width="85"/><DataGridTextColumn Header="Kart Yok" Binding="{Binding NoPunchDays}" Width="75"/><DataGridTextColumn Header="Geç Gün" Binding="{Binding LateDays}" Width="70"/><DataGridTextColumn Header="Geç dk" Binding="{Binding LateMinutes}" Width="70"/><DataGridTextColumn Header="Erken dk" Binding="{Binding EarlyMinutes}" Width="75"/><DataGridTextColumn Header="Fazla dk" Binding="{Binding OvertimeMinutes}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>

   <TabItem Header="Dönemler"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PDKS Dönemleri" FontSize="20" FontWeight="Bold"/><DataGrid Grid.Row="1" x:Name="PeriodGrid"><DataGrid.Columns><DataGridTextColumn Header="Dönem" Binding="{Binding Label}" Width="120"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Not" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="2" x:Name="PeriodWritePanel" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Seçili Dönem" FontSize="18" FontWeight="Bold"/><TextBlock Text="Üst bardaki ay/yıl için açma-kapama işlemi." Foreground="#708196"/><TextBlock Text="Dönem notu" Margin="0,8,0,0"/><TextBox x:Name="PeriodNoteBox" Height="70" AcceptsReturn="True"/><Button Content="Dönemi Aç" Click="OpenPeriodButton_Click" Background="#EAF7EF"/><Button Content="Dönemi Kapat" Click="ClosePeriodButton_Click" Background="#FFF0F0"/></StackPanel></Border></Grid></TabItem>

   <TabItem Header="Gruplar / Vardiyalar"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Çalışma Grupları" FontSize="20" FontWeight="Bold"/><DataGrid Grid.Row="1" x:Name="GroupGrid" SelectionChanged="GroupGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Giriş" Binding="{Binding EntryTime}" Width="75"/><DataGridTextColumn Header="Çıkış" Binding="{Binding ExitTime}" Width="75"/><DataGridTextColumn Header="Geç Tol." Binding="{Binding LateTolerance}" Width="70"/><DataGridTextColumn Header="Erken Tol." Binding="{Binding EarlyTolerance}" Width="75"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="60"/></DataGrid.Columns></DataGrid></Grid></Border><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GroupWritePanel"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Grup Tanımı" FontSize="18" FontWeight="Bold"/><TextBlock Text="Grup adı"/><TextBox x:Name="GroupNameBox"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Giriş"/><TextBox x:Name="GroupEntryBox" Text="08:30"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Çıkış"/><TextBox x:Name="GroupExitBox" Text="19:00"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Geç tolerans dk"/><TextBox x:Name="GroupLateBox" Text="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Erken tolerans dk"/><TextBox x:Name="GroupEarlyBox" Text="0"/></StackPanel></Grid><CheckBox x:Name="GroupActiveCheck" Content="Aktif" IsChecked="True" Margin="4"/><Button Content="Grubu Kaydet" Click="SaveGroupButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="Personeli Gruba Ata" FontSize="17" FontWeight="Bold"/><ComboBox x:Name="AssignPersonCombo" DisplayMemberPath="FullName" Margin="0,6,0,2"/><ComboBox x:Name="AssignGroupCombo" DisplayMemberPath="Name" Margin="0,2,0,6"/><Button Content="Atamayı Kaydet" Click="AssignGroupButton_Click"/></StackPanel></Border></StackPanel></ScrollViewer></Grid></TabItem>

   <TabItem Header="Bölümler"><Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Bölümler" FontSize="20" FontWeight="Bold"/><TextBlock Text="Bölüm ana verisi KY ERP personel kartından gelir." Foreground="#708196"/></StackPanel><DataGrid Grid.Row="1" x:Name="DepartmentGrid"><DataGrid.Columns><DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="*"/><DataGridTextColumn Header="Personel Sayısı" Binding="{Binding PersonCount}" Width="140"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>

