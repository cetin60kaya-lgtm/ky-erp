<Window x:Class="KyPdks.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KY PDKS" Height="760" Width="1180" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource KyDark}" Margin="0,0,12,0">
            <TextBlock Text="KY" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="KY PDKS" FontWeight="Bold" FontSize="22" Foreground="{StaticResource KyDark}"/>
            <TextBlock Text="Yerel kart toplama · KY ERP senkron" Foreground="#718197" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Padding="10,6" CornerRadius="12" BorderBrush="#BFE2CD" BorderThickness="1" Background="#EEFAF3" Margin="0,0,8,0">
            <TextBlock x:Name="AgentStateText" Text="Agent kontrol ediliyor" Foreground="#277246" FontWeight="SemiBold"/>
          </Border>
          <Border Padding="10,6" CornerRadius="12" BorderBrush="#C7D7EA" BorderThickness="1" Background="#F2F7FC">
            <TextBlock x:Name="ErpStateText" Text="ERP: Oturum yok" Foreground="#31587E" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
        <StackPanel>
          <TextBlock Text="BAĞLANTI" FontSize="11" FontWeight="Bold" Foreground="#718197" Margin="0,0,0,8"/>
          <TextBlock Text="KY ERP Kullanıcısı" FontWeight="SemiBold" Foreground="{StaticResource KyDark}"/>
          <TextBox x:Name="UsernameBox" ToolTip="Kullanıcı adı veya e-posta"/>
          <TextBlock Text="Parola" FontWeight="SemiBold" Foreground="{StaticResource KyDark}"/>
          <PasswordBox x:Name="PasswordBox"/>
          <Button x:Name="LoginButton" Content="KY ERP ile Giriş" Click="LoginButton_Click" Background="{StaticResource KyBlue}" Foreground="White" BorderThickness="0"/>

          <Border x:Name="MfaPanel" Visibility="Collapsed" Background="#FFF8E7" BorderBrush="#F0D69A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Authenticator doğrulaması" FontWeight="Bold" Foreground="#795B17"/>
              <TextBlock x:Name="MfaProviderText" Text="6 haneli kod" Foreground="#866B2B" Margin="0,3,0,4"/>
              <TextBox x:Name="MfaCodeBox" MaxLength="6"/>
              <Button Content="Doğrula" Click="MfaButton_Click"/>
            </StackPanel>
          </Border>

          <Separator Margin="0,14"/>
          <TextBlock Text="YEREL SİSTEM" FontSize="11" FontWeight="Bold" Foreground="#718197" Margin="0,0,0,8"/>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Yerel DB" Foreground="#42566F"/>
            <TextBlock Grid.Column="1" x:Name="DatabaseStateText" Text="-" FontWeight="SemiBold"/>
          </Grid>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Bekleyen kart" Foreground="#42566F"/>
            <TextBlock Grid.Column="1" x:Name="PendingCountText" Text="0" FontWeight="Bold"/>
          </Grid>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Son kart" Foreground="#42566F"/>
            <TextBlock Grid.Column="1" x:Name="LastPunchText" Text="-" FontWeight="SemiBold"/>
          </Grid>
          <Button Content="Yerel Veriyi Yenile" Click="RefreshLocalButton_Click" Margin="4,14,4,0"/>
          <Button x:Name="SyncButton" Content="ERP'ye Senkronize Et" Click="SyncButton_Click" IsEnabled="False"/>
          <Button Content="Kart Import Klasörünü Aç" Click="OpenImportButton_Click"/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4">
          <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel><TextBlock Text="Bugün Kart" Foreground="#718197"/><TextBlock x:Name="TodayCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource KyDark}"/></StackPanel>
          </Border>
          <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel><TextBlock Text="Bekleyen Senkron" Foreground="#718197"/><TextBlock x:Name="PendingBigText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#B06A16"/></StackPanel>
          </Border>
          <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,8,0">
            <StackPanel><TextBlock Text="Senkronlanan" Foreground="#718197"/><TextBlock x:Name="SyncedCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#277246"/></StackPanel>
          </Border>
          <Border Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel><TextBlock Text="Kaynak" Foreground="#718197"/><TextBlock Text="Kart Agent" FontSize="20" FontWeight="Bold" Foreground="#31587E"/></StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource KyBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="2,0,2,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Son Kart Hareketleri" FontSize="18" FontWeight="Bold" Foreground="{StaticResource KyDark}"/>
                <TextBlock Text="Ham kayıt önce yerelde tutulur; ERP senkronu kart kaydını değiştirmez." Foreground="#718197" FontSize="12"/>
              </StackPanel>
              <TextBlock Grid.Column="1" x:Name="NoticeText" VerticalAlignment="Center" Foreground="#31587E" FontWeight="SemiBold"/>
            </Grid>
            <DataGrid Grid.Row="1" x:Name="PunchGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Kart No" Binding="{Binding CardNo}" Width="110"/>
                <DataGridTextColumn Header="Tarih" Binding="{Binding WorkDate}" Width="130"/>
                <DataGridTextColumn Header="Saat" Binding="{Binding EventTime}" Width="90"/>
                <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="150"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding SyncState}" Width="130"/>
                <DataGridTextColumn Header="Dosya / Referans" Binding="{Binding SourceRef}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#172D49">
      <Grid Margin="16,0">
        <TextBlock Text="KY ERP · KY PDKS Windows" Foreground="#DDE8F5" VerticalAlignment="Center" FontSize="11"/>
        <TextBlock x:Name="DeviceText" HorizontalAlignment="Right" Foreground="#AFC2D8" VerticalAlignment="Center" FontSize="11"/>
      </Grid>
    </Border>
  </Grid>
</Window>
