<Window x:Class="KyPdks.Desktop.PdksMasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KY PDKS · Detay Yönetim" Height="820" Width="1260" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#D8E2EF" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PDKS Detay Yönetim" FontSize="23" FontWeight="Bold" Foreground="#172D49"/>
                    <TextBlock Text="Vardiya ve servis: KY ERP D1 · Terminal: yalnız bu Windows cihazının konfigürasyonu" Foreground="#708196"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,6" CornerRadius="12" Background="#EDF7FF" BorderBrush="#B7D4EC" BorderThickness="1" Margin="0,0,8,0">
                        <TextBlock x:Name="DataStateText" Text="D1 bağlantısı" Foreground="#31587E" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="D1 Yenile" Click="RefreshButton_Click" Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="12">
            <TabItem Header="Vardiyalar / Gruplar">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GroupsGrid_SelectionChanged" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Vardiya" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Giriş" Binding="{Binding EntryTime}" Width="80"/>
                            <DataGridTextColumn Header="Çıkış" Binding="{Binding ExitTime}" Width="80"/>
                            <DataGridTextColumn Header="Geç Tol." Binding="{Binding LateTolerance}" Width="80"/>
                            <DataGridTextColumn Header="Erken Tol." Binding="{Binding EarlyTolerance}" Width="85"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="VARDİYA TANIMI" FontWeight="Bold" Foreground="#708196"/>
                            <TextBlock Text="Kod"/><TextBox x:Name="GroupCodeBox"/>
                            <TextBlock Text="Ad"/><TextBox x:Name="GroupNameBox"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0"><TextBlock Text="Giriş"/><TextBox x:Name="GroupEntryBox" Text="08:30"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Çıkış"/><TextBox x:Name="GroupExitBox" Text="19:00"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0"><TextBlock Text="Geç tolerans (dk)"/><TextBox x:Name="GroupLateBox" Text="5"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Erken tolerans (dk)"/><TextBox x:Name="GroupEarlyBox" Text="10"/></StackPanel>
                            </Grid>
                            <CheckBox x:Name="GroupActiveCheck" Content="Aktif" IsChecked="True" Margin="0,6,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Yeni" Click="NewGroupButton_Click"/>
                                <Button x:Name="SaveGroupButton" Content="D1'e Kaydet" Click="SaveGroupButton_Click" Background="#1F5D96" Foreground="White"/>
                            </StackPanel>
                            <Separator Margin="0,16,0,12"/>
                            <TextBlock Text="PERSONELE VARDİYA ATA" FontWeight="Bold" Foreground="#708196"/>
                            <ComboBox x:Name="GroupPersonCombo" DisplayMemberPath="FullName"/>
                            <ComboBox x:Name="GroupAssignCombo" DisplayMemberPath="Name"/>
                            <Button x:Name="AssignGroupButton" Content="Vardiyayı D1'e Ata" Click="AssignGroupButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Servisler">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ServicesGrid_SelectionChanged" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Servis" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Güzergâh / Not" Binding="{Binding RouteNote}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SERVİS TANIMI" FontWeight="Bold" Foreground="#708196"/>
                            <TextBlock Text="Kod"/><TextBox x:Name="ServiceCodeBox"/>
                            <TextBlock Text="Ad"/><TextBox x:Name="ServiceNameBox"/>
                            <TextBlock Text="Güzergâh / Not"/><TextBox x:Name="ServiceRouteBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <CheckBox x:Name="ServiceActiveCheck" Content="Aktif" IsChecked="True" Margin="0,6,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Yeni" Click="NewServiceButton_Click"/>
                                <Button x:Name="SaveServiceButton" Content="D1'e Kaydet" Click="SaveServiceButton_Click" Background="#1F5D96" Foreground="White"/>
                            </StackPanel>
                            <Separator Margin="0,16,0,12"/>
                            <TextBlock Text="PERSONELE SERVİS ATA" FontWeight="Bold" Foreground="#708196"/>
                            <ComboBox x:Name="ServicePersonCombo" DisplayMemberPath="FullName"/>
                            <ComboBox x:Name="ServiceAssignCombo" DisplayMemberPath="Name"/>
                            <Button x:Name="AssignServiceButton" Content="Servisi D1'e Ata" Click="AssignServiceButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Personel / Bölüm / Görev">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Bu liste KY ERP personel masterından gelir. Bölüm, görev ve kart burada ikinci kez tutulmaz." Foreground="#586C82" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="PeopleGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding PersonnelCode}" Width="90"/>
                            <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Bölüm" Binding="{Binding Department}" Width="180"/>
                            <DataGridTextColumn Header="Görev" Binding="{Binding Title}" Width="180"/>
                            <DataGridTextColumn Header="Kart" Binding="{Binding CardNo}" Width="100"/>
                            <DataGridTextColumn Header="SGK" Binding="{Binding SgkStatus}" Width="70"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Saat / Terminal">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="WINDOWS AGENT / TERMİNAL AYARI" FontWeight="Bold" Foreground="#708196" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="Kaynak modu" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="SourceModeCombo">
                            <ComboBoxItem Content="Hedef / TR500" Tag="HEDEF_TR500"/><ComboBoxItem Content="Dosya" Tag="FILE"/>
                            <ComboBoxItem Content="TCP Server" Tag="TCP_SERVER"/><ComboBoxItem Content="TCP Client" Tag="TCP_CLIENT"/>
                            <ComboBoxItem Content="Serial / COM" Tag="SERIAL"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="Hedef okuma dosyası" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="HedefReadBox"/>
                        <TextBlock Grid.Row="3" Text="Hedef yazma dosyası" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="HedefWriteBox"/>
                        <TextBlock Grid.Row="4" Text="TCP Host" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="TcpHostBox"/>
                        <TextBlock Grid.Row="5" Text="TCP Port" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="TcpPortBox"/>
                        <TextBlock Grid.Row="6" Text="COM Port" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" x:Name="SerialPortBox"/>
                        <TextBlock Grid.Row="7" Text="Baud" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" x:Name="SerialBaudBox"/>
                        <TextBlock Grid.Row="8" Text="Tarama (ms)" VerticalAlignment="Center"/><TextBox Grid.Row="8" Grid.Column="1" x:Name="ScanIntervalBox"/>
                        <TextBlock Grid.Row="9" Text="Senkron (sn)" VerticalAlignment="Center"/><TextBox Grid.Row="9" Grid.Column="1" x:Name="SyncIntervalBox"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="AutoSyncCheck" Content="Otomatik senkron" Margin="0,8,20,8"/><CheckBox x:Name="FileImportCheck" Content="Dosya import açık" Margin="0,8"/></StackPanel>
                        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Varsayılan Hedef / TR500" Click="HedefDefaultsButton_Click"/>
                            <Button x:Name="SaveTerminalButton" Content="Bu Cihaza Kaydet" Click="SaveTerminalButton_Click" Background="#1F5D96" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#172D49" Padding="10,0">
            <TextBlock x:Name="StatusText" Text="Hazır" Foreground="White" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
