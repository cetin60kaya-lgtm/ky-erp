<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>HKN.Personel.Native.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KYERP.PDKS</AssemblyName>
    <Product>KY PDKS 6.3.7 CANLI</Product>
    <Company>KY ERP</Company>
    <Description>KY PDKS 6.3.7 CANLI - single simple shell, one-minute safe live terminal sync, durable live TNF/raw archive, weekly/monthly card control and device records preserved</Description>
    <Version>6.3.7</Version>
    <FileVersion>6.3.7.0</FileVersion>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KYERP.PDKS.Core\KYERP.PDKS.Core.csproj" />
  </ItemGroup>
  <Target Name="BuildTerminalDeviceBridge" AfterTargets="Build" Condition="Exists('$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe')">
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe&quot; /nologo /platform:x86 /target:exe /out:&quot;$(TargetDir)KYERP.TerminalBridge.exe&quot; /reference:System.Windows.Forms.dll /reference:System.Drawing.dll /reference:Microsoft.CSharp.dll &quot;$(MSBuildProjectDirectory)\..\..\tools\TerminalDeviceBridge\Program.cs&quot;" />
  </Target>
  <Target Name="PublishTerminalDeviceBridge" AfterTargets="Publish" Condition="Exists('$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe')">
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe&quot; /nologo /platform:x86 /target:exe /out:&quot;$(PublishDir)KYERP.TerminalBridge.exe&quot; /reference:System.Windows.Forms.dll /reference:System.Drawing.dll /reference:Microsoft.CSharp.dll &quot;$(MSBuildProjectDirectory)\..\..\tools\TerminalDeviceBridge\Program.cs&quot;" />
  </Target>
</Project>
