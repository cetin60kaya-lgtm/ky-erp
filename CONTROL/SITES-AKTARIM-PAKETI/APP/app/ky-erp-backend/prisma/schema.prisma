generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Print region definitions for standardization across companies
model PrintRegionDefinition {
  id            String   @id @default(uuid())
  mainCompanyId String?
  regionCode    String
  regionName    String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("print_region_definitions")
}

// Per-model persisted print regions (optional migration)
model ModelPrintRegion {
  id            String   @id @default(uuid())
  modelRecordId String
  mainCompanyId String?
  regionCode    String
  regionName    String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("model_print_regions")
}

model MainCompany {
  id                      String                   @id @default(uuid())
  slug                    String                   @unique
  name                    String
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  activityLogs            ActivityLog[]
  companies               Company[]
  companyAliases          CompanyAlias[]
  currentAccountMovements CurrentAccountMovement[]
  documentFiles           DocumentFile[]
  documents               Document[]
  storedFiles             StoredFile[]
  fileStorageRules        FileStorageRule[]
  jobs                    Job[]
  legacyPermissions       LegacyPermission[]
  productAlias            ProductAlias[]
  products                Product[]
  legacyRoles             LegacyRole[]
  legacyUsers             LegacyUser[]
  vatRecords              VatRecord[]

  @@map("main_companies")
}

model LegacyUser {
  id              String           @id @default(uuid())
  mainCompanySlug String           @map("main_company_slug")
  email           String
  name            String
  passwordHash    String?          @map("password_hash")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  roles           LegacyUserRole[]
  mainCompany     MainCompany      @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, email])
  @@index([mainCompanySlug])
  @@map("users")
}

model LegacyRole {
  id              String           @id @default(uuid())
  mainCompanySlug String           @map("main_company_slug")
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  mainCompany     MainCompany      @relation(fields: [mainCompanySlug], references: [slug])
  users           LegacyUserRole[]

  @@unique([mainCompanySlug, name])
  @@index([mainCompanySlug])
  @@map("roles")
}

model LegacyUserRole {
  userId String     @map("user_id")
  roleId String     @map("role_id")
  role   LegacyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model LegacyPermission {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  code            String
  description     String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, code])
  @@index([mainCompanySlug])
  @@map("permissions")
}

enum Role {
  ADMIN
  MUHASEBE
  DESEN
  IMALAT
  BOYAHANE
  IK
  VIEWER

  @@map("auth_role")
}

enum ModuleKey {
  DASHBOARD
  MUHASEBE
  FIRMA_CARI
  BELGE_ISLEM
  KDV
  CEK_ODEME
  DESEN
  IMALAT
  BOYAHANE
  IK
  ADMIN
  RAPORLAR

  @@map("auth_module_key")
}

model User {
  id                 String                 @id @default(uuid())
  username           String                 @unique
  passwordHash       String                 @map("password_hash")
  fullName           String                 @map("full_name")
  role               Role
  isActive           Boolean                @default(true) @map("is_active")
  mustChangePassword Boolean                @default(false) @map("must_change_password")
  lastLoginAt        DateTime?              @map("last_login_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  permissions        UserModulePermission[]

  @@map("auth_users")
}

model UserModulePermission {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  moduleKey  ModuleKey @map("module_key")
  canView    Boolean   @default(false) @map("can_view")
  canCreate  Boolean   @default(false) @map("can_create")
  canUpdate  Boolean   @default(false) @map("can_update")
  canDelete  Boolean   @default(false) @map("can_delete")
  canApprove Boolean   @default(false) @map("can_approve")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
  @@map("auth_user_module_permissions")
}

model Company {
  id                        String                   @id @default(uuid())
  mainCompanySlug           String                   @map("main_company_slug")
  legacyId                  String?                  @map("legacy_id")
  name                      String
  normalizedName            String                   @map("normalized_name")
  type                      String                   @default("SATICI")
  taxNo                     String?                  @map("tax_no")
  taxOffice                 String?                  @map("tax_office")
  phone                     String?
  email                     String?
  address                   String?
  defaultRecordType         String?                  @default("RESMI") @map("default_record_type")
  firmaTuru                 String?                  @map("firma_turu")
  varsayilanRaporKategoriId String?                  @map("varsayilan_rapor_kategori_id")
  defaultVatRate            Decimal                  @default(0) @map("default_vat_rate")
  vatIncludedMode           String?                  @default("HARIC") @map("vat_included_mode")
  currentBalance            Decimal                  @default(0) @map("current_balance")
  openingBalance            Decimal                  @default(0) @map("opening_balance")
  isActive                  Boolean                  @default(true) @map("is_active")
  isFavorite                Boolean                  @default(false) @map("is_favorite")
  note                      String?
  source                    String?                  @default("MANUAL")
  deletedAt                 DateTime?                @map("deleted_at")
  deletedBy                 String?                  @map("deleted_by")
  deleteReason              String?                  @map("delete_reason")
  raw                       Json?
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  mainCompany               MainCompany              @relation(fields: [mainCompanySlug], references: [slug])
  aliases                   CompanyAlias[]
  movements                 CurrentAccountMovement[]
  documents                 Document[]
  vatRecords                VatRecord[]

  @@unique([mainCompanySlug, legacyId])
  @@unique([mainCompanySlug, normalizedName])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, normalizedName])
  @@index([mainCompanySlug, isActive])
  @@index([mainCompanySlug, updatedAt])
  @@index([mainCompanySlug, currentBalance])
  @@index([varsayilanRaporKategoriId])
  @@map("companies")
}

model CompanyAlias {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  companyId       String      @map("company_id")
  rawName         String      @map("raw_name")
  normalizedName  String      @map("normalized_name")
  isActive        Boolean     @default(true) @map("is_active")
  source          String?     @default("MANUAL")
  taxNo           String?     @map("tax_no")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@unique([mainCompanySlug, normalizedName])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, normalizedName])
  @@map("company_aliases")
}

model CurrentAccountMovement {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  companyId       String      @map("company_id")
  movementDate    DateTime    @map("movement_date")
  movementType    String      @map("movement_type")
  sourceType      String      @map("source_type")
  documentNo      String?     @map("document_no")
  documentId      String?     @map("document_id")
  description     String?
  debit           Decimal     @default(0)
  credit          Decimal     @default(0)
  amount          Decimal     @default(0)
  effect          Decimal     @default(0)
  balanceAfter    Decimal     @default(0) @map("balance_after")
  legacyId        String?     @map("legacy_id")
  raw             Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  company         Company     @relation(fields: [companyId], references: [id])
  document        Document?   @relation(fields: [documentId], references: [id])
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@index([mainCompanySlug])
  @@index([mainCompanySlug, movementDate])
  @@index([companyId, movementDate])
  @@index([mainCompanySlug, companyId, movementDate])
  @@index([mainCompanySlug, documentNo])
  @@map("current_account_movements")
}

model Document {
  id              String                   @id @default(uuid())
  mainCompanySlug String                   @map("main_company_slug")
  companyId       String?                  @map("company_id")
  documentNo      String?                  @map("document_no")
  documentType    String?                  @map("document_type")
  sourceType      String?                  @map("source_type")
  date            DateTime?
  subtotal        Decimal                  @default(0)
  vatTotal        Decimal                  @default(0) @map("vat_total")
  grandTotal      Decimal                  @default(0) @map("grand_total")
  status          String                   @default("kontrol_bekliyor")
  processedAt     DateTime?                @map("processed_at")
  rejectReason    String?                  @map("reject_reason")
  fileHash        String?                  @map("file_hash")
  detectedType    String?                  @map("detected_type")
  targetType      String?                  @map("target_type")
  targetModule    String?                  @map("target_module")
  targetRecordId  String?                  @map("target_record_id")
  firmMatchStatus String?                  @map("firm_match_status")
  confidence      Decimal?
  routeStatus     String?                  @map("route_status")
  routeMessage    String?                  @map("route_message")
  raporKategoriId String?                  @map("rapor_kategori_id")
  kategoriKaynagi String?                  @map("kategori_kaynagi")
  deletedAt       DateTime?                @map("deleted_at")
  deletedBy       String?                  @map("deleted_by")
  deleteReason    String?                  @map("delete_reason")
  raw             Json?
  metadata        Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  movements       CurrentAccountMovement[]
  files           DocumentFile[]
  company         Company?                 @relation(fields: [companyId], references: [id])
  mainCompany     MainCompany              @relation(fields: [mainCompanySlug], references: [slug])

  @@index([mainCompanySlug])
  @@index([mainCompanySlug, date])
  @@index([mainCompanySlug, fileHash])
  @@index([mainCompanySlug, documentType])
  @@index([mainCompanySlug, targetType])
  @@index([mainCompanySlug, routeStatus])
  @@index([raporKategoriId])
  @@map("documents")
}

model MuhasebeRaporKategorisi {
  id                 String   @id @default(uuid())
  mainCompanySlug    String   @map("main_company_slug")
  ad                 String
  kod                String?
  kategoriTipi       String   @map("kategori_tipi")
  anaKategoriId      String?  @map("ana_kategori_id")
  sira               Int      @default(0)
  aktifMi            Boolean  @default(true) @map("aktif_mi")
  sistemKategorisiMi Boolean  @default(false) @map("sistem_kategorisi_mi")
  renk               String?
  aciklama           String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([mainCompanySlug, ad])
  @@index([mainCompanySlug])
  @@index([mainCompanySlug, kategoriTipi])
  @@index([anaKategoriId])
  @@map("muhasebe_rapor_kategorileri")
}

model MuhasebeRaporManuelKalem {
  id              String    @id @default(uuid())
  mainCompanySlug String    @map("main_company_slug")
  ad              String
  kartTipi        String    @default("KUCUK") @map("kart_tipi")
  kategoriId      String?   @map("kategori_id")
  firmaId         String?   @map("firma_id")
  tarih           DateTime?
  baslangic       DateTime?
  bitis           DateTime?
  tutar           Decimal   @default(0)
  kdv             Decimal   @default(0)
  aciklama        String?
  aktifMi         Boolean   @default(true) @map("aktif_mi")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([mainCompanySlug])
  @@index([kategoriId])
  @@index([firmaId])
  @@map("muhasebe_rapor_manuel_kalemler")
}

model DocumentFile {
  id              String      @id @default(uuid())
  mainCompanySlug String      @map("main_company_slug")
  documentId      String      @map("document_id")
  filePath        String      @map("file_path")
  fileName        String      @map("file_name")
  mimeType        String?     @map("mime_type")
  fileSize        Int?        @map("file_size")
  checksum        String?
  role            String?     @default("archive")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  document        Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  mainCompany     MainCompany @relation(fields: [mainCompanySlug], references: [slug])

  @@index([mainCompanySlug])
  @@index([documentId])
  @@map("document_files")
}

enum FileStorageModule {
  MUHASEBE_MUSTERI
  MUHASEBE_TEDARIKCI
  DESEN
  CEK
  IK_PERSONEL
  TASNIF

  @@map("file_storage_module")
}

enum FileDocumentType {
  MUSTERI_GELEN_IRSALIYE
  MUSTERI_FATURA
  BIZIM_IRSALIYE
  BIZIM_FATURA
  SATIS_FATURA
  TASNIF_RAPORU
  TEDARIKCI_FATURA
  TEDARIKCI_IRSALIYE
  LOT_BELGESI
  DESEN_GORSEL
  KANAL_GORSEL
  DESEN_PDF
  CEK_GORSEL
  PERSONEL_KIMLIK
  PERSONEL_SOZLESME
  PERSONEL_SGK
  PERSONEL_IZIN
  PERSONEL_DIGER

  @@map("file_document_type")
}

enum FileStatus {
  ACTIVE
  ARCHIVED
  DELETED
  DUPLICATE
  ERROR

  @@map("file_status")
}

enum OwnerType {
  DOCUMENT
  DOCUMENT_LINE
  MODEL
  DESEN
  PERSONEL
  CEK
  CARI
  LOT
  NONE

  @@map("owner_type")
}

model StoredFile {
  id               String            @id @default(uuid())
  mainCompanyId    String            @map("main_company_id")
  module           FileStorageModule
  documentType     FileDocumentType  @map("document_type")
  ownerType        OwnerType         @default(NONE) @map("owner_type")
  ownerId          String?           @map("owner_id")
  firmId           String?           @map("firm_id")
  modelId          String?           @map("model_id")
  personelId       String?           @map("personel_id")
  cariId           String?           @map("cari_id")
  originalFileName String            @map("original_file_name")
  storedFileName   String            @map("stored_file_name")
  mimeType         String?           @map("mime_type")
  extension        String?
  fileSize         Int?              @map("file_size")
  fileHash         String            @map("file_hash")
  sourcePath       String?           @map("source_path")
  relativePath     String            @map("relative_path")
  absolutePath     String            @map("absolute_path")
  publicUrl        String?           @map("public_url")
  thumbnailPath    String?           @map("thumbnail_path")
  previewPath      String?           @map("preview_path")
  status           FileStatus        @default(ACTIVE)
  isDeleted        Boolean           @default(false) @map("is_deleted")
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  createdBy        String?           @map("created_by")
  mainCompany      MainCompany       @relation(fields: [mainCompanyId], references: [id])

  @@index([mainCompanyId])
  @@index([mainCompanyId, fileHash, isDeleted])
  @@index([mainCompanyId, module, documentType])
  @@index([ownerType, ownerId])
  @@map("stored_files")
}

model FileStorageRule {
  id                 String            @id @default(uuid())
  mainCompanyId      String            @map("main_company_id")
  module             FileStorageModule
  documentType       FileDocumentType  @map("document_type")
  displayName        String            @map("display_name")
  targetPathTemplate String            @map("target_path_template")
  allowedExtensions  String            @map("allowed_extensions")
  maxFileSizeMb      Int?              @map("max_file_size_mb")
  imageResizeEnabled Boolean           @default(false) @map("image_resize_enabled")
  imageMaxWidth      Int?              @map("image_max_width")
  imageMaxHeight     Int?              @map("image_max_height")
  thumbEnabled       Boolean           @default(false) @map("thumb_enabled")
  thumbWidth         Int?              @map("thumb_width")
  thumbHeight        Int?              @map("thumb_height")
  watchEnabled       Boolean           @default(false) @map("watch_enabled")
  watchSourcePath    String?           @map("watch_source_path")
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  mainCompany        MainCompany       @relation(fields: [mainCompanyId], references: [id])

  @@unique([mainCompanyId, module, documentType])
  @@index([mainCompanyId])
  @@map("file_storage_rules")
}

enum DocumentIntakeKind {
  OUR_INVOICE
  OUR_DISPATCH
  CUSTOMER_DISPATCH
  SUPPLIER_INVOICE
  EXPENSE_INVOICE
  UNKNOWN

  @@map("document_intake_kind")
}

enum DocumentIntakeStatus {
  UPLOADED
  PARSED
  CONTROL_WAITING
  MISSING_INFO
  READY
  APPROVED
  REJECTED
  ARCHIVED

  @@map("document_intake_status")
}

model DocumentIntake {
  id                String                @id @default(uuid())
  batchId           String                @map("batch_id")
  mainCompanyId     String?               @map("main_company_id")
  mainCompanySlug   String                @map("main_company_slug")
  originalFileName  String                @map("original_file_name")
  filePath          String                @map("file_path")
  fileHash          String?               @map("file_hash")
  mimeType          String?               @map("mime_type")
  documentNo        String?               @map("document_no")
  invoiceNo         String?               @map("invoice_no")
  dispatchNo        String?               @map("dispatch_no")
  documentKind      DocumentIntakeKind    @default(UNKNOWN) @map("document_kind")
  direction         String?
  scenario          String?
  documentType      String?               @map("document_type")
  issueDate         DateTime?             @map("issue_date")
  dueDate           DateTime?             @map("due_date")
  issuerName        String?               @map("issuer_name")
  issuerTaxNo       String?               @map("issuer_tax_no")
  receiverName      String?               @map("receiver_name")
  receiverTaxNo     String?               @map("receiver_tax_no")
  firmId            String?               @map("firm_id")
  firmDraftJson     Json?                 @map("firm_draft_json")
  modelId           String?               @map("model_id")
  modelGuess        String?               @map("model_guess")
  currency          String?               @default("TRY")
  subtotal          Decimal               @default(0)
  vatTotal          Decimal               @default(0) @map("vat_total")
  grandTotal        Decimal               @default(0) @map("grand_total")
  status            DocumentIntakeStatus  @default(CONTROL_WAITING)
  missingFieldsJson Json?                 @map("missing_fields_json")
  parseRawJson      Json?                 @map("parse_raw_json")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  lines             DocumentIntakeLine[]
  matches           DocumentIntakeMatch[]

  @@index([mainCompanySlug])
  @@index([mainCompanySlug, status])
  @@index([mainCompanySlug, documentKind])
  @@index([mainCompanySlug, fileHash])
  @@map("document_intakes")
}

model DocumentIntakeLine {
  id                String         @id @default(uuid())
  documentIntakeId  String         @map("document_intake_id")
  lineNo            Int?           @map("line_no")
  rawName           String?        @map("raw_name")
  description       String?
  productId         String?        @map("product_id")
  productDraftJson  Json?          @map("product_draft_json")
  quantity          Decimal        @default(0)
  unit              String?
  kg                Decimal        @default(0)
  packageInfo       String?        @map("package_info")
  unitPrice         Decimal        @default(0) @map("unit_price")
  discountRate      Decimal        @default(0) @map("discount_rate")
  discountAmount    Decimal        @default(0) @map("discount_amount")
  subtotal          Decimal        @default(0)
  vatRate           Decimal        @default(0) @map("vat_rate")
  vatAmount         Decimal        @default(0) @map("vat_amount")
  total             Decimal        @default(0)
  lotNo             String?        @map("lot_no")
  modelGuess        String?        @map("model_guess")
  missingFieldsJson Json?          @map("missing_fields_json")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  documentIntake    DocumentIntake @relation(fields: [documentIntakeId], references: [id], onDelete: Cascade)

  @@index([documentIntakeId])
  @@map("document_intake_lines")
}

model DocumentIntakeMatch {
  id               String         @id @default(uuid())
  documentIntakeId String         @map("document_intake_id")
  matchType        String         @map("match_type")
  matchedId        String?        @map("matched_id")
  score            Decimal        @default(0)
  status           String
  note             String?
  documentIntake   DocumentIntake @relation(fields: [documentIntakeId], references: [id], onDelete: Cascade)

  @@index([documentIntakeId])
  @@index([matchType])
  @@map("document_intake_matches")
}

model DocumentFolderSetting {
  id              String    @id @default(uuid())
  mainCompanyId   String?   @map("main_company_id")
  mainCompanySlug String    @map("main_company_slug")
  folderKey       String    @map("folder_key")
  folderName      String    @map("folder_name")
  folderPath      String    @map("folder_path")
  targetType      String    @map("target_type")
  targetModule    String    @map("target_module")
  active          Boolean   @default(true)
  lastScanAt      DateTime? @map("last_scan_at")
  processedCount  Int       @default(0) @map("processed_count")
  failedCount     Int       @default(0) @map("failed_count")
  duplicateCount  Int       @default(0) @map("duplicate_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([mainCompanySlug, folderKey])
  @@index([mainCompanySlug])
  @@map("document_folder_settings")
}

model FolderWatchLog {
  id              String   @id @default(uuid())
  mainCompanyId   String?  @map("main_company_id")
  mainCompanySlug String   @map("main_company_slug")
  folderSettingId String?  @map("folder_setting_id")
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  fileHash        String?  @map("file_hash")
  status          String
  targetType      String?  @map("target_type")
  targetModule    String?  @map("target_module")
  targetRecordId  String?  @map("target_record_id")
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([mainCompanySlug])
  @@index([folderSettingId])
  @@index([fileHash])
  @@map("folder_watch_logs")
}

model DocumentReadTemplate {
  id                String    @id @default(uuid())
  mainCompanyId     String?   @map("main_company_id")
  mainCompanySlug   String    @map("main_company_slug")
  companyId         String?   @map("company_id")
