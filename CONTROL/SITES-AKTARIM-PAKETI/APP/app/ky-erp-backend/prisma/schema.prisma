  cashAmount        Decimal   @default(0) @map("cash_amount")
  deductionAmount   Decimal   @default(0) @map("deduction_amount")
  netPayable        Decimal   @default(0) @map("net_payable")
  status            String    @default("DRAFT")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([mainCompanySlug])
  @@index([employeeId])
  @@map("payrolls")
}
